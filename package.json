{
  "name": "@absolutejs/rendering",
  "version": "0.12.0",
  "description": "Three.js material ownership, destination coverage, rigid-object triplanar mapping and isolated React Spring hosts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./spring": {
      "types": "./dist/spring.d.ts",
      "import": "./dist/spring.js",
      "default": "./dist/spring.js"
    },
    "./visibility": {
      "types": "./dist/visibility.d.ts",
      "import": "./dist/visibility.js",
      "default": "./dist/visibility.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/rendering.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test ./tests",
    "check:package": "bun run build && bun run test",
    "test:browser": "bun scripts/verify-browser.cjs",
    "test:spring:browser": "bun scripts/verify-spring.cjs",
    "test:triplanar:browser": "bun scripts/verify-triplanar.cjs",
    "test:foliage:browser": "bun scripts/verify-foliage.cjs",
    "test:foliage:environment": "bun scripts/verify-foliage-environment.cjs",
    "test:mips:browser": "bun scripts/verify-prepared-mips.cjs",
    "test:arrays:browser": "bun scripts/verify-prepared-arrays.cjs",
    "test:instances:browser": "bun scripts/verify-instance-stream.cjs",
    "test:visibility:browser": "bun scripts/verify-visibility.cjs"
  },
  "peerDependencies": {
    "three": ">=0.186.0 <0.188.0",
    "react": ">=19.3.0 <20",
    "@react-three/fiber": ">=9.8.2 <10",
    "@react-spring/animated": ">=10.1.2 <11",
    "@react-spring/web": ">=10.1.2 <11",
    "@react-spring/three": ">=10.1.2 <11",
    "three-mesh-bvh": ">=0.8.3 <0.9.0"
  },
  "devDependencies": {
    "three": "0.186.1",
    "@types/three": "0.186.0",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3",
    "playwright": "1.61.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@react-three/fiber": "9.8.2",
    "@react-spring/animated": "10.1.2",
    "@react-spring/web": "10.1.2",
    "@react-spring/three": "10.1.2",
    "@react-spring/shared": "10.1.2",
    "three-mesh-bvh": "0.8.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@react-spring/animated": {
      "optional": true
    },
    "@react-spring/web": {
      "optional": true
    },
    "@react-spring/three": {
      "optional": true
    },
    "three-mesh-bvh": {
      "optional": true
    }
  }
}
